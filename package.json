{
  "name": "sureui",
  "version": "0.2.0",
  "description": "Open source confirmation components for shadcn/ui: undo, hold to confirm, type to confirm and more. Built on Base UI.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "pnpm registry:build && next build",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:coverage": "vitest run --config tests/vitest.config.ts --coverage",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "registry:build": "shadcn build",
    "smoke:install": "./scripts/smoke-install.sh",
    "fix-tailwind": "tailwind-suggest-canonical-classes \"{app,components/site,components/ui/sureui}/**/*.{tsx,ts}\" --css ./app/globals.css"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@mdx-js/loader": "^3.1.1",
    "@next/mdx": "^16.3.6",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.21.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@laststance/tailwind-suggest-canonical-classes": "^0.1.2",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.2",
    "ai": "^7.0.120",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vitest": "^5.0.2"
  },
  "prettier": {
    "endOfLine": "lf",
    "semi": false,
    "singleQuote": false,
    "tabWidth": 2,
    "trailingComma": "es5",
    "printWidth": 80,
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "app/globals.css",
    "tailwindFunctions": [
      "cn",
      "cva"
    ],
    "overrides": [
      {
        "files": "*.mdx",
        "options": {
          "embeddedLanguageFormatting": "off"
        }
      }
    ]
  },
  "pnpm": {
    "allowBuilds": {
      "sharp": true,
      "unrs-resolver": true,
      "msw": false
    }
  }
}
