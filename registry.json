    {
      "name": "undo-toast",
      "type": "registry:lib",
      "title": "Undo Toast",
      "description": "undoToast(message) shows a Sonner toast with an Undo button and resolves true when it closes or false if Undo is clicked. Run the real action only after it resolves true.",
      "dependencies": ["sonner"],
      "registryDependencies": ["button", "sonner"],
      "files": [
        {
          "path": "components/ui/sureui/fill.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/fill.ts"
        },
