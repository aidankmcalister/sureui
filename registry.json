      "description": "An inline form that calls onConfirm only after the exact phrase is typed and every acknowledgement is checked. Supports inline undo and a pending state for an async onConfirm.",
      "registryDependencies": [
        "button",
        "checkbox",
        "input",
        "label"
      ],
