{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "sureui",
  "homepage": "https://sureui.com",
  "items": [
    {
      "name": "confirm-button",
      "type": "registry:ui",
      "title": "Confirm Button",
      "description": "A Button that confirms with a click, a second click, or a press-and-hold, with optional inline undo and an async pending state.",
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "components/ui/sureui/fill.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/fill.ts"
        },
        {
          "path": "components/ui/sureui/undo-window.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/undo-window.ts"
        },
        {
          "path": "components/ui/sureui/confirmation.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/confirmation.ts"
        },
        {
          "path": "components/ui/sureui/confirm-button.tsx",
          "type": "registry:ui",
          "target": "@ui/sureui/confirm-button.tsx"
        }
      ],
      "categories": ["confirmation", "button"]
    },
    {
      "name": "type-to-confirm",
      "type": "registry:ui",
      "title": "Type to Confirm",
      "description": "An inline form that only calls onConfirm after the exact phrase is typed and every acknowledgement is checked, with optional inline undo and an async pending state.",
      "registryDependencies": ["button", "checkbox", "input", "label"],
      "files": [
        {
          "path": "components/ui/sureui/fill.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/fill.ts"
        },
        {
          "path": "components/ui/sureui/undo-window.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/undo-window.ts"
        },
        {
          "path": "components/ui/sureui/confirmation.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/confirmation.ts"
        },
        {
          "path": "components/ui/sureui/confirm-button.tsx",
          "type": "registry:ui",
          "target": "@ui/sureui/confirm-button.tsx"
        },
        {
          "path": "components/ui/sureui/type-to-confirm.tsx",
          "type": "registry:ui",
          "target": "@ui/sureui/type-to-confirm.tsx"
        }
      ],
      "categories": ["confirmation", "form"]
    },
    {
      "name": "confirm-dialog",
      "type": "registry:ui",
      "title": "Confirm Dialog",
      "description": "An optional alert dialog that wraps a ConfirmButton or TypeToConfirm as its confirm action, closing only after an async onConfirm settles. Includes useConfirm, which returns an awaitable confirm() and a dialog element you render yourself.",
      "registryDependencies": ["alert-dialog", "button", "checkbox", "input", "label"],
      "files": [
        {
          "path": "components/ui/sureui/fill.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/fill.ts"
        },
        {
          "path": "components/ui/sureui/undo-window.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/undo-window.ts"
        },
        {
          "path": "components/ui/sureui/confirmation.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/confirmation.ts"
        },
        {
          "path": "components/ui/sureui/confirm-button.tsx",
          "type": "registry:ui",
          "target": "@ui/sureui/confirm-button.tsx"
        },
        {
          "path": "components/ui/sureui/type-to-confirm.tsx",
          "type": "registry:ui",
          "target": "@ui/sureui/type-to-confirm.tsx"
        },
        {
          "path": "components/ui/sureui/confirm-dialog.tsx",
          "type": "registry:ui",
          "target": "@ui/sureui/confirm-dialog.tsx"
        }
      ],
      "categories": ["confirmation", "dialog"]
    },
    {
      "name": "undo-toast",
      "type": "registry:lib",
      "title": "Undo Toast",
      "description": "undoToast(message) shows a Sonner toast with an Undo button and resolves true when it closes or false if Undo is clicked. Run the real action only after it resolves true.",
      "dependencies": ["sonner"],
      "registryDependencies": ["button", "sonner"],
      "files": [
        {
          "path": "components/ui/sureui/fill.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/fill.ts"
        },
        {
          "path": "components/ui/sureui/undo-window.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/undo-window.ts"
        },
        {
          "path": "components/ui/sureui/undo-toast.tsx",
          "type": "registry:lib",
          "target": "@ui/sureui/undo-toast.tsx"
        }
      ],
      "docs": "Needs the shadcn <Toaster /> in your root layout.",
      "categories": ["confirmation", "toast"]
    }
  ]
}
