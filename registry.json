      "title": "Confirm Dialog",
      "description": "An optional alert dialog that wraps a ConfirmButton or TypeToConfirm as its confirm action, closing only after an async onConfirm settles. Includes useConfirm, which returns an awaitable confirm() and a dialog element you render yourself.",
      "registryDependencies": ["alert-dialog", "button", "checkbox", "input", "label"],
