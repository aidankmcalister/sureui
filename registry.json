    {
      "name": "confirm-button",
      "type": "registry:ui",
      "title": "Confirm Button",
      "description": "A Button that confirms on a click, a second click or a press and hold. Supports inline undo and a pending state for an async onConfirm.",
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "components/ui/sureui/fill.ts",
          "type": "registry:lib",
          "target": "@ui/sureui/fill.ts"
        },
        {
