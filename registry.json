    {
      "name": "consequences",
      "type": "registry:ui",
      "title": "Consequences",
      "description": "A list of what a confirmation will remove, with counts and names that collapse to \"and N more\". Pass it to TypeToConfirm or ConfirmDialog through their consequences prop.",
      "files": [
