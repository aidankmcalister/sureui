    {
      "name": "confirm-popover",
      "type": "registry:ui",
      "title": "Confirm Popover",
      "description": "A popover anchored to any trigger, with one line about the consequence and a ConfirmButton, for actions that need a sentence but not a dialog. It stays open while an async onConfirm is pending.",
      "registryDependencies": [
        "popover",
        "button"
