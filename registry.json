          "type": "registry:lib",
          "target": "@ui/sureui/undo-toast.tsx"
        }
      ],
      "docs": "Needs the shadcn <Toaster /> in your root layout.",
      "categories": [
        "confirmation",
        "toast"
      ]
    },
    {
      "name": "undoable",
      "type": "registry:ui",
      "title": "Undoable",
      "description": "Wraps a list item or table row. Removing it collapses the row in place to a label and an Undo button at the same height, then runs onConfirm when the undo window ends.",
      "dependencies": [
        "@base-ui/react"
      ],
      "registryDependencies": [
        "button"
