    {
      "name": "undo-toast",
      "type": "registry:lib",
      "title": "Undo Toast",
      "description": "undoToast(message) shows a Sonner toast with an Undo button. It resolves true when the toast closes and false if Undo is clicked, so run the action only on true.",
      "dependencies": ["sonner"],
      "registryDependencies": ["button", "sonner"],
      "files": [
